# ---------------------------------------------------------------------------
# AMAYA — Premium Accessories · example environment
# Copy to .env and adjust. Everything here has sensible local defaults.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# In this workspace `npm run dev` boots an embedded PostgreSQL (PGlite) server
# on 127.0.0.1:5432 automatically, so the default works out of the box.
# Point this at a managed Postgres (Neon, Supabase, RDS...) for production.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/amaya"

# Secret used to sign session JWTs. MUST be changed in production.
AUTH_SECRET="change-me-amaya-2026-super-secret-key"

# Public site URL (used in metadata / absolute links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Neon Object Storage (S3-compatible, 5 GB free) — product & category images.
# Provisioned in the Neon project: `neon deploy` with a neon.ts declaring a
# bucket `amaya-media` with `access: 'public_read'`, which writes these AWS_*
# vars automatically — or fill them manually from a Neon storage credential
# (token_id → AWS_ACCESS_KEY_ID, s3_secret_access_key → AWS_SECRET_ACCESS_KEY).
# Required by POST /api/admin/uploads; the storefront needs no config because
# uploaded images are plain public HTTPS URLs stored in the DB.
# ---------------------------------------------------------------------------
AWS_ENDPOINT_URL_S3=""
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
NEON_STORAGE_BUCKET="amaya-media"

# Business contact information shown on the storefront (can also be edited
# from the admin Settings page — database values take precedence).
BUSINESS_PHONE="+213 555 00 00 00"
BUSINESS_EMAIL="contact@amaya.dz"
BUSINESS_ADDRESS="Oran, Algérie"

# ---------------------------------------------------------------------------
# Company legal identifiers printed on French invoices.
# Leave empty until the registration is known: the lines are omitted entirely
# rather than printing placeholder zeros.
# ---------------------------------------------------------------------------
COMPANY_ADDRESS="Oran, Algérie"
COMPANY_RC=""
COMPANY_NIF=""
COMPANY_AI=""

# Optional: override the invoice contact details.
# BUSINESS_PHONE / BUSINESS_EMAIL above are reused when these are unset.
